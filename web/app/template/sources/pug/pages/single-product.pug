					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-2', data-toggle='tab' ) Additional information
					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-3', data-toggle='tab' ) Delivery and payment

				// Tab panes
				.tab-content.tab-content-1
					div#tabs-1-1.tab-pane.fade.show.active
						.comment
							.unit.unit-spacing-lg.flex-column.flex-sm-row.align-items-lg-center
								.unit-left: +img( 'user-3-119x119.jpg' ).comment-image
								.unit-body
									.group-sm.group-justify.align-items-center
										div: .group-xs.group-middle
											.heading-6.comment-author Anna Smith
											.box-rating
												span.icon.mdi.mdi-star
												span.icon.mdi.mdi-star
												span.icon.mdi.mdi-star
												span.icon.mdi.mdi-star
												span.icon.mdi.mdi-star-half

										.comment-time: time( datetime='2019' ) Nov 30, 2019

									p.comment-text Contencios sunt gemnas de brevis magister. Torquis cresceres, tanquam fatalis candidatus. Alter demissios ducunt ad elevatus. Est varius fluctus, cesaris. Rumor, hydra, et bromium. Regius, bassus itineris tramitems cito reperire de pius, noster idoleum.

						h6 Your Review
						//RD Mailform
						form.rd-form.rd-mailform( data-form-output='form-output-global', data-form-type='contact', method='post', action='bat/rd-mailform.php' )
							.row.row-20.gutter-20
								.col-sm-6.col-md-4
									.form-wrap
										input#contact-name.form-input( type='text', name='name', data-constraints='@Required' )
										label.form-label( for='contact-name' ) Your Name

								.col-sm-6.col-md-4
									.form-wrap
										input#contact-phone.form-input( type='text', name='phone', data-constraints='@Numeric' )
										label.form-label( for='contact-phone' ) Phone

								.col-md-4
									.form-wrap
										input#contact-email.form-input( type='email', name='email', data-constraints='@Email @Required' )
										label.form-label( for='contact-email' ) E-mail

								.col-12
									.form-wrap
										label.form-label( for='contact-message') Message
										textarea#contact-message.form-input( name='message', data-constraints='@Required' )

								.col-12
									.form-button: button.button.button-lg.button-gradient( type='submit' ) Submit

					div#tabs-1-2.tab-pane.fade
