//Swiper
section.section.swiper-container.swiper-slider.swiper-slider-6.bg-default.bg-image-1.overlay-creative( data-autoplay='5000', data-simulate-touch='false', data-slide-effect='fade' )
	.swiper-wrapper
		.swiper-slide
			.swiper-slide-caption: .container: .row.row-30.justify-content-center.flex-column-reverse.flex-lg-row
				.col-lg-6
					.swiper-media-box
						+img('swiper-img-1-1005x602.png')
				.col-lg-6
					.swiper-caption-box
						.heading-1
							span.d-inline-block.d-lg-block #1 Place
							span.d-inline-block.d-lg-block for Bikes
						.swiper-caption-box__subtitle
							span We offer a great variety of motorbikes.
						a(href="shop.html").button.button-gradient.button-lg Shop Now
		.swiper-slide
			.swiper-slide-caption: .container: .row.row-30.justify-content-center.flex-column-reverse.flex-lg-row
				.col-lg-6
					.swiper-media-box
						+img('swiper-img-2-1005x602.png')
				.col-lg-6
					.swiper-caption-box
						.heading-1
							span.d-inline-block.d-lg-block parts for
							span.d-inline-block.d-lg-block your bike
						.swiper-caption-box__subtitle
							span Easily find and shop for the parts you need.
						a(href="shop.html").button.button-gradient.button-lg Shop Now
		.swiper-slide
			.swiper-slide-caption: .container: .row.row-30.justify-content-center.flex-column-reverse.flex-lg-row
				.col-lg-6
					.swiper-media-box.mode-2
						+img('swiper-img-3-1005x602.png')
				.col-lg-6
					.swiper-caption-box
						.heading-1
							span.d-inline-block.d-lg-block New & used
							span.d-inline-block.d-lg-block Motorcycles
						.swiper-caption-box__subtitle
							span Get any bike at an affordable price.
						a(href="shop.html").button.button-gradient.button-lg Shop Now


	//Swiper Pagination
	.swiper-pagination

	//Swiper Navigation
	.swiper-button-prev
	.swiper-button-next
