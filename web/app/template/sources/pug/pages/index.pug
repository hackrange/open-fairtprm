extends ../_skeleton

include ../components/_boxes
include ../components/_services
include ../components/_video
include ../components/_team
include ../components/_quote
include ../components/_pricing
include ../components/_posts
include ../components/_thumbnails
include ../components/_products
include ../components/_counter
block variables


block page
	include ../sections/_header-modern
	include ../sections/_swiper-slider-2

	section.section
		// Owl Carousel
		.owl-carousel.owl-creative( data-loop='false', data-items='1', data-sm-items='2', data-xl-items='2', , data-xxl-items='3', data-dots='true', data-mouse-drag='false' )
			+box-abby({
				bg: 'bg-primary',
				subtitle: 'Select a bike you need',
				title: 'motorbikes',
				text: 'We offer a wide variety of new and used bikes from widely known brands.',
				media: 'prod-type-1-248x373.png'
			})

			+box-abby({
				bg: 'bg-red-2',
				subtitle: 'Clothes for riders',
				title: 'Apparel',
				text: 'Check out our massive collection of driving apparel available online at our shop.',
				media: 'prod-type-2-264x342.png'
			})
			+box-abby({
				bg: 'bg-accent-red',
				subtitle: 'Accessories',
				title: 'Gear',
				text: 'We also offer a wide range of accessories and gear for riders  regardless of their budget.',
				media: 'prod-type-3-298x315.png'
			})


	//Classes
	section.section.section-xl.bg-gray-100.text-center.position-relative.overflow-hidden
		.floating-text__right Sale
		.container.position-relative
			h6.title-8.wow.fadeInUp list of the latest promotions
			h2.font-weight-bold.wow.fadeInUp special offers
			.row.row-30.row-narrow-80.row-xl
				.col-lg-6
					a(href="shop.html").box-offer
						.box-offer__header
							.box-offer__media
								+img('home-img-1-290x331')
							h2.box-offer__title
								span 2019
								span year
								span models
							.box-offer__sale
								.big 20
								.sale-group
									span.percent %
									span off
						.box-offer__footer
							h4 Kawasaki, Honda, and Yamaha
							span available while stocks last
				.col-lg-6
					a(href="shop.html").box-offer.reverse
						.box-offer__header
							.box-offer__media
								+img('home-img-2-181x335.png')
							h2.box-offer__title
								span Grab
								span Your
								span Honda
							.box-offer__sale
								.sale-group
									span $
									.big 200
									span off
						.box-offer__footer
							h4 Honda CBR1000RR
							span on sale until June 15


	section.section.section-xl.bg-default.text-center

		.container.position-relative
			h6.title-8.wow.fadeInUp Top products from our shop
			h2.font-weight-bold.wow.fadeInUp Featured Products
			.row.row-xl.row-30.row-md-50
				.col-sm-6.col-lg-4
					+product({
						category: 'motorcycles',
						title: 'Honda CBR300R',
						img: 'product-1-320x240',
						price: '4500',
						caption: 'Honda’s CBR300R has sportbike credentials designed to satisfy any rider.'
					}).block-md
				.col-sm-6.col-lg-4
					+product({
						category: 'Helmets',
						title: 'Klim Men\'s F4 Snocross',
						img: 'product-2-320x240',
						price: '250',
						caption: 'This Men\'s F4 Snocross Helmet by Klim is a perfect addition to your riding image.'
					}).block-md
				.col-sm-6.col-lg-4
					+product({
						category: 'clothing',
						title: 'Motorcycle Riding Jacket',
						img: 'product-3-320x240',
						price: '150',
						caption: 'Choose this jacket to add to your riding apparel & enhance your experience.'
					}).block-md
				.col-12
					a.button.button-gradient.button-md(href="shop.html") View all products


	//About us
	section.section.bg-gray-100.section-xxl.position-relative.overflow-hidden
		.floating-text__left About
		.container: .row.justify-content-center.flex-lg-row-reverse.justify-content-xl-between.row-40
			.col-md-11.col-lg-5.wow.fadeInRight
				h6.title-8 A few Words about us
				h2.font-weight-bold #1 Motorbike Shop
				p.big Brightcycle bike shop is one of America’s best motorcycle shops that has been offering premium motorcycles, service, and parts since 1999.
				a.button.button-md.button-gradient( href='about-us.html' ) learn More
			.col-sm-10.col-md-8.col-lg-7.col-xl-6.wow.fadeIn
				+video-modern({
					img: 'video-bg-1-584x385',
					link: 'https://www.youtube.com/watch?v=1UWpbtUupQQ'
				})

	//Icon List
	section.section.bg-gray-13
		.row.no-gutters.bordered-1
			.col-sm-6.col-xl-3
				+box-classic-1({
					icon: 'mdi mdi-reply',
					title: 'Reasonable prices',
					text: 'If you didn’t like your bike, you can always return it during the first 2 weeks of its usage.'
				}).box-classic-1.wow.fadeInUp
			.col-sm-6.col-xl-3
				+box-classic-1({
					icon: 'mdi mdi-account-star-variant',
					title: 'Professional Team',
					text: 'Our sales managers and consultants are always glad to help you choose a bike.'
				}).box-classic-1.wow.fadeInUp( data-wow-delay='.05s' )
			.col-sm-6.col-xl-3
				+box-classic-1({
					icon: 'mdi mdi-truck',
					title: 'Free Delivery',
					text: 'Our delivery service guarantees quick and secure delivery of your favorite motorcycle.'
				}).box-classic-1.wow.fadeInUp( data-wow-delay='.1s' )
			.col-sm-6.col-xl-3
				+box-classic-1({
					icon: 'mdi mdi-cash-usd',
					title: 'payment Methods',
					text: 'We offer a variety of payment methods including cash, credit cards, and cheques.'
				}).box-classic-1.wow.fadeInUp( data-wow-delay='.15s' )


	//Counters
	section.section.section-lg.bg-default.text-center
		.container
			.row.row-30.justify-content-center
				.col-sm-6.col-md-4
					+counter({
						value: 450,
						text: 'Motorcycle Models'
					}).block-sm
				.col-sm-6.col-md-4
					+counter({
						value: 78,
						text: 'Awards'
					}).block-sm
				.col-sm-6.col-md-4
					+counter({
						value: 600,
						postfix: '+',
						text: 'Satisfied Customers'
					}).block-sm

	//Testimonials
	section.section.section-xxl.bg-gray-100.section-decor-1
		.container.tabs-custom.tabs-style-2: .row.row-30.justify-content-center
			.col-md-7.wow.fadeInLeft
				h6.title-8 Testimonials
				h2.font-weight-bold What our Clients say
				//Tab panes
				.tab-content.inset-xl-right-40
					div#tabs-1-1.tab-pane.fade.show.active
						+quote-modern({
							text: 'I am extremely pleased with the process of purchasing my new Honda Africa Twin from Brightcycle. I knew exactly what I wanted so it was easy to choose and purchase this motorcycle.',
							title: 'Helen Russell',
							subtitle: 'Regular Client'
						})
					div#tabs-1-2.tab-pane.fade
						+quote-modern({
							text: 'I\'ve bought two motorcycles from this place and never plan to shop anywhere else! Low-pressure atmosphere, friendly mechanics, and excellent prices. I\'m treated like family here!',
							title: 'Joseph Wilson',
							subtitle: 'Regular Client'
						})
					div#tabs-1-3.tab-pane.fade
						+quote-modern({
							text: 'Extremely helpful staff. The team at Brightcycle saved my road trip! I called all over town looking for a new motorcycle and they provided me with what I needed, quickly and efficiently.',
							title: 'Eric Thompson',
							subtitle: 'Regular Client'
						})
					div#tabs-1-4.tab-pane.fade
						+quote-modern({
							text: 'Great, friendly service. Brightcycle never tried to sell me something I don\'t need. They\'ve never snobbed my weird taste in motorbikes and that’s why I recommend them to everyone!',
							title: 'Gary Wood',
							subtitle: 'Regular Client'
						})
					div#tabs-1-5.tab-pane.fade
						+quote-modern({
							text: 'This place is awesome.  I was looking for a reliable place to buy a motorcycle and Brightcycle team proved to be extremely friendly and helpful. They set me up with the Kawasaki Ninja.',
							title: 'Amy Washington',
							subtitle: 'Regular Client'
						})
			.col-md-5.wow.fadeInRight
				//Nav tabs
				ul.nav.nav-tabs
					li.nav-item( role='presentation' ): a.nav-link.active( href='#tabs-1-1', data-toggle='tab' ): +img('user-5-89x89')
					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-2', data-toggle='tab' ): +img('user-12-89x89')
					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-3', data-toggle='tab' ): +img('user-13-89x89')
					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-4', data-toggle='tab' ): +img('user-14-89x89')
					li.nav-item( role='presentation' ): a.nav-link( href='#tabs-1-5', data-toggle='tab' ): +img('user-4-89x89')



	//Our blog
	section.section.section-lg.section-inset-6.bg-default.text-center
		.container
			h6.title-8.wow.fadeInUp Our blog
			h2.font-weight-bold.wow.fadeInUp Latest posts
			// Owl Carousel
			.owl-carousel.owl-style-4.owl-nav-1( data-items='1', data-nav='true', data-dots='true', data-autoplay='false', data-margin='30', data-xl-margin='170', data-smart-speed='400' )
				.row.row-30
					.col-sm-6
						+post-creative({
							img: 'post-17-448x299',
							title: 'Motorcycle security and anti-theft: Ways to save your bike',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-03-12', text: 'March 12, 2019'}
						})
					.col-sm-6
						+post-creative({
							img: 'post-18-448x299',
							title: 'Motorcycle security and anti-theft: Ways to save your bike',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-04-15', text: 'April 15, 2019'}
						})
				.row.row-30
					.col-sm-6
						+post-creative({
							img: 'post-19-448x299',
							title: 'How the telescopic fork front suspension works',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-05-22', text: 'May 22, 2019'}
						})
					.col-sm-6
						+post-creative({
							img: 'post-20-448x299',
							title: 'Why motorcyclists won\'t wear high-visibility gear \n',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-05-22', text: 'May 22, 2019'}
						})
				.row.row-30
					.col-sm-6
						+post-creative({
							img: 'post-21-448x299',
							title: 'Buying inexpensive and exotic motorcycles',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-04-15', text: 'April 15, 2019'}
						})
					.col-sm-6
						+post-creative({
							img: 'post-22-448x299',
							title: 'Winter Bike Preparation Superthread',
							tag: {class: 'post-tag-gradient', text: 'News'},
							time: {date: '2019-03-12', text: 'March 12, 2019'}
						})

	//CTA
	section.section.section-lg.text-center
		.container.wow.fadeInUp
			h6.title-8 Have a Question?
			h2.font-weight-bold Contact Us now
			p.big We are always happy to answer all your questions.
			a.button.button-lg.button-gradient( href='contact-us.html' ) Get in touch

	//Gallery
	section.section
		.owl-carousel.owl-style-3( data-items='1', data-sm-items='2', data-md-items='3', data-lg-items='4', data-mouse-drag='false', data-dots='true', data-loop='false', data-lightgallery='group' )
			+thumbnail-modern({
				img: 'gallery-1-480x362',
				imgOriginal: 'gallery-1-1200x800-original'
			}).wow.fadeIn
			+thumbnail-modern({
				img: 'gallery-2-480x362',
				imgOriginal: 'gallery-2-1200x800-original'
			}).wow.fadeIn( data-wow-delay='.05s' )
			+thumbnail-modern({
				img: 'gallery-3-480x362',
				imgOriginal: 'gallery-3-1200x800-original'
			}).wow.fadeIn( data-wow-delay='.1s' )
			+thumbnail-modern({
				img: 'gallery-4-480x362',
				imgOriginal: 'gallery-4-1200x800-original'
			}).wow.fadeIn( data-wow-delay='.15s' )

	//Google Map
	section.section
		.section-xl.bg-gray-100.google-map-style-1
			.container.contacts-paul-wrap: .row.justify-content-sm-end: .col-sm-6.col-md-5.wow.fadeInRight
				ul.contacts-paul
					li: .unit.align-items-center
						.unit-left: span.icon.mdi.mdi-map-marker
						.unit-body: a.big( href='#' ) 652 Main Road, Apt 12
							br
							| New York, USA 10033
					li: .unit.align-items-center
						.unit-left: span.icon.mdi.mdi-cellphone-android
						.unit-body: a.heading-5( href='tel:#' ) +1 800 123 1234
					li: .unit.align-items-center
						.unit-left: span.icon.mdi.mdi-email-outline
						.unit-body: a.big( href='mailto:#' ) info@demolink.org
			include ../includes/_google-map

	include ../sections/_footer-modern