extends  ../_skeleton

//- Includes
include ../components/_products
include ../components/_quote

block variables
	- var activeCategory = 'shop'
	- var pageName = 'Single Product'

block page 
	include ../sections/_header-modern

	+breadcrumbs

	// Single Product
	section.section.section-lg.bg-default
