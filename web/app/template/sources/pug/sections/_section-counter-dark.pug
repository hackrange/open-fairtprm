//Counters
section.section.section-lg.bg-gray-700.text-center
	.container
		.row.row-30.justify-content-center
			.col-sm-6.col-md-4
				+counter({
					value: 450,
					text: 'Motorcycle Models'
				}).block-sm
			.col-sm-6.col-md-4
				+counter({
					value: 78,
					text: 'Awards'
				}).block-sm
			.col-sm-6.col-md-4
				+counter({
					value: 600,
					postfix: '+',
					text: 'Satisfied Customers'
				}).block-sm